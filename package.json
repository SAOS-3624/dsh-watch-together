{
  "name": "dsh-watch-together",
  "version": "0.1.0",
  "description": "Watch a video together with a text-only agent: follow the user's real playback position, hand over one segment at a time just before it ends, and keep a single text stream of scripted lines, interjections and the user's replies.",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "video",
    "watch-together",
    "watch-party",
    "companion",
    "playback",
    "subtitle",
    "caption",
    "tts"
  ],
  "homepage": "https://github.com/SAOS-3624/dsh-watch-together#readme",
  "bugs": {
    "url": "https://github.com/SAOS-3624/dsh-watch-together/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/SAOS-3624/dsh-watch-together.git"
  },
  "author": "SAOS-3624",
  "license": "Apache-2.0",
  "type": "module",
  "main": "./src/index.js",
  "exports": {
    ".": "./src/index.js",
    "./register": "./src/register.js",
    "./tool-spec": "./src/tool-spec.js",
    "./watch": "./src/watch.js",
    "./batches": "./src/batches.js",
    "./chat": "./src/chat.js",
    "./voice": "./src/voice.js",
    "./speech-bus": "./src/speech-bus.js",
    "./voice-adapter": "./src/voice-adapter.js"
  },
  "bin": {
    "dsh-watch": "./bin/watch.mjs",
    "dsh-watch-lines": "./bin/lines.mjs"
  },
  "files": [
    "src",
    "bin",
    "examples",
    "extension",
    "scripts",
    "docs",
    "cordis.patch.yml",
    "dsh.plugin.json",
    "README.md",
    "CHANGELOG.md",
    "LICENSE",
    "NOTICE"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "test": "node --test",
    "pretest": "node scripts/sync-dep.mjs",
    "sync:dep": "node scripts/sync-dep.mjs",
    "prepublishOnly": "node scripts/check-syntax.mjs && node --test",
    "check": "node scripts/check-syntax.mjs",
    "doctor": "node bin/watch.mjs doctor",
    "install:extension": "node bin/watch.mjs install-extension",
    "sim": "node scripts/watch-sim.mjs",
    "e2e": "node scripts/watch-e2e.mjs"
  },
  "dependencies": {
    "dsh-video-storyboard": "^0.5.11"
  },
  "peerDependencies": {
    "@deepseek-ai/dsh-tools": ">=0.1.0-rc.7"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/dsh-tools": {
      "optional": true
    }
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  }
}
