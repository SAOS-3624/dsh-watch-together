{
  "manifest_version": 3,
  "name": "陪看位置桥 (Watch Together)",
  "version": "0.1.0",
  "description": "把自己浏览器里正在播的视频进度，报给本机的陪看插件。装一次，之后正常开浏览器就行。",
  "author": "SAOS-3624",
  "homepage_url": "https://github.com/SAOS-3624/dsh-watch-together",
  "minimum_chrome_version": "116",
  "permissions": [],
  "host_permissions": [
    "http://127.0.0.1:9377/*",
    "http://localhost:9377/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["http://*/*", "https://*/*"],
      "js": ["content.js"],
      "run_at": "document_idle",
      "all_frames": false
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "陪看位置桥"
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
